# Optional public origin used for social preview metadata.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Private server-to-server RVC connection. Never prefix these with NEXT_PUBLIC_.
RVC_ENGINE_URL=http://127.0.0.1:8000
RVC_ENGINE_API_TOKEN=change-me

# The engine receives the same value when it runs outside Docker Compose.
VOICEMERGE_API_TOKEN=change-me
VOICEMERGE_ALLOWED_ORIGINS=http://localhost:3000
